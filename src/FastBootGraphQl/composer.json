{
    "name": "graphcommerce/module-fast-boot-graph-ql",
    "description": "A faster GraphQL request on php-fpm: the schema as a PHP array, built-in scalars without the type walk, queries parsed and validated once, the response cache id without selects",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "graphcommerce/module-fast-boot-cache": "*",
        "magento/framework": "^103.0.8",
        "magento/module-graph-ql": "^100.4.8",
        "magento/module-graph-ql-cache": "^100.4.5",
        "magento/module-customer-graph-ql": "^100.4.8",
        "magento/module-catalog-graph-ql": "^100.4.8",
        "magento/module-tax": "^100.4.8",
        "magento/module-customer": "^103.0.8",
        "webonyx/graphql-php": "^15.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "GraphCommerce\\FastBootGraphQl\\": ""
        }
    }
}
